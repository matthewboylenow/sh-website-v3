# Saint Helen 3.0 — environment variables
#
# Copy to .env.local for local development. Every variable below is read
# somewhere in the codebase; a missing one is usually a silent failure
# rather than a crash, which is why this file exists.
#
# Variables marked REQUIRED IN PRODUCTION must be set on Vercel before the
# DNS flip. The ones marked with a warning have a fallback that is fine
# locally and dangerous in production.

# ── Database ─────────────────────────────────────────────────────────────
# REQUIRED. Neon Postgres connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth.js ──────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET=
# REQUIRED IN PRODUCTION. The canonical site origin, e.g.
# https://sainthelen.org — magic links are built from this.
AUTH_URL=http://localhost:3000

# ── Email (Resend) ───────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION.
#
# ⚠️  Without RESEND_API_KEY, lib/email.ts logs to the server console and
#     RETURNS SUCCESS. Every form shows "Thank you" and nobody receives
#     anything. Welcome forms and prayer requests are not persisted, so
#     those would vanish with no trace. Set this before telling anyone the
#     forms work.
RESEND_API_KEY=
EMAIL_FROM="Saint Helen Church <no-reply@send.sainthelen.org>"
EMAIL_REPLY_TO=parish@sainthelen.org

# ── SMS sign-in (Twilio Verify) ──────────────────────────────────────────
# Optional, but if SMS sign-in is offered these must all be set.
#
# ⚠️  Off production, a missing config makes "123456" a valid code so the
#     admin can be built without Twilio. In production that fallback is
#     refused outright (lib/sms.ts) — SMS sign-in simply stops working and
#     says to use the email link. Do not remove that guard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Vercel Blob (photos and PDFs) ────────────────────────────────────────
# REQUIRED. Uploads and the media library do not work without it.
BLOB_READ_WRITE_TOKEN=
# The CDN host uploads are served from, behind cdn.sainthelen.org.
BLOB_STORE_HOST=

# ── Site ─────────────────────────────────────────────────────────────────
# Used for absolute URLs in metadata, the sitemap and emails.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# ── Feature flags ────────────────────────────────────────────────────────
# All three default to ON. Set to "false" to disable.
NEXT_PUBLIC_ENABLE_GIVE_FAB=true
# Turn this off until the Subsplash embed exists, or /mass shows an empty
# livestream card.
NEXT_PUBLIC_ENABLE_LIVESTREAM=true
NEXT_PUBLIC_ENABLE_A11Y_WIDGET=true

# Defaults to OFF. While it is off, a ministry lead who clicks into their
# own ministry gets a 404 rather than a message. Decide before inviting any
# ministry leads.
ENABLE_MINISTRY_SELF_SERVICE=false

# ── Integrations ─────────────────────────────────────────────────────────
# USCCB daily readings proxy. Defaults to the public feed when unset.
READINGS_UPSTREAM=

# ── Tests ────────────────────────────────────────────────────────────────
# Only needed to run tests/integration/*.db.test.ts. Point it at a
# throwaway database, never at Neon production or a preview branch.
TEST_DATABASE_URL=
